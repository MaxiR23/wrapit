generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Access {
  EDIT
  COMMENT
  VIEW
}

enum ProjectStatus {
  NEW
  IN_PROGRESS
  PAUSED
  DONE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ViewMode {
  GRID
  LIST
}

enum NotificationType {
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  INVITATION_REJECTED
}

enum ProfileVisibility {
  ANYONE
  TEAM
  ADMINS_ONLY
}

enum ActivityEventType {
  CARD_CREATED
  CARD_MOVED
  CARD_ARCHIVED
  CARD_RESTORED
  CARD_DELETED
  ASSIGNEES_CHANGED
  LABEL_CHANGED
  DUE_DATE_CHANGED
  COMMENT_ADDED
  PROJECT_CREATED
  MEMBER_ADDED
  MEMBER_REMOVED
  OWNERSHIP_TRANSFERRED
  MEMBER_LEFT
  MEMBER_PROMOTED
  MEMBER_DEMOTED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  PROJECT_DELETED
}

enum RestoreUndoKind {
  CARDS
  PROJECT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  username      String   @unique
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects             Project[]
  sessions             Session[]
  accounts             Account[]
  memberships          Membership[]
  sentInvitations      Invitation[]    @relation("InvitationInviter")
  receivedInvitations  Invitation[]    @relation("InvitationInvitee")
  notifications        Notification[]
  preferences          UserPreferences?
  profile              UserProfile?
  recentProjects       RecentProject[]
  statuses             UserStatus[]
  cardAssignments      CardAssignee[]
  cardComments         Comment[]
  archivedCards        Card[]             @relation("CardArchivedBy")
  archivedProjects     Project[]          @relation("ProjectArchivedBy")
  restoreUndoTokens    RestoreUndoToken[]
  activityEvents       ActivityEvent[]
  activeStatusId       String?     @unique
  activeStatus         UserStatus? @relation("UserActiveStatus", fields: [activeStatusId], references: [id], onDelete: SetNull)
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      ProjectStatus @default(NEW)
  cardCounter Int           @default(0)
  createdAt   DateTime      @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  publicLinkEnabled Boolean @default(false)

  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("ProjectArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  columns           Column[]
  memberships       Membership[]
  invitations       Invitation[]
  recentProjects    RecentProject[]
  labels            Label[]
  activityEvents    ActivityEvent[]
  restoreUndoTokens RestoreUndoToken[]

  @@index([archivedById])
}

model Column {
  id    String @id @default(cuid())
  title String
  order Float

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  cards Card[]
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String?
  code        String
  order       Float
  dueDate     DateTime?
  dueTimeZone String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  labelId String?
  label   Label?  @relation(fields: [labelId], references: [id], onDelete: Restrict)

  archivedById String?
  archivedBy   User?   @relation("CardArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  assignees CardAssignee[]
  subtasks  Subtask[]
  comments  Comment[]

  @@index([labelId])
  @@index([archivedById])
}

model Subtask {
  id     String  @id @default(cuid())
  text   String
  done   Boolean @default(false)
  order  Float

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model Comment {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([authorId])
}

model CardAssignee {
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

model Label {
  id        String @id @default(cuid())
  name      String
  tone      String
  order     Int

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@unique([projectId, order])
}

model Membership {
  id                String   @id @default(cuid())
  role              Role     @default(MEMBER)
  access            Access   @default(EDIT)
  accessBeforeAdmin Access?
  starred           Boolean  @default(false)
  createdAt         DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Invitation {
  id        String           @id @default(cuid())
  role      Role             @default(MEMBER)
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User    @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User    @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@unique([projectId, inviteeId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  invitationId String?
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([invitationId])
}

model UserPreferences {
  id       String   @id @default(cuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewMode ViewMode @default(GRID)

  showCardLabel     Boolean @default(true)
  showCardCode      Boolean @default(true)
  showCardComments  Boolean @default(true)
  showCardSubtasks  Boolean @default(true)
  showCardDueDate   Boolean @default(true)
  showCardAssignees Boolean @default(true)
}

model UserStatus {
  id          String @id @default(cuid())
  name        String
  description String
  color       String
  order       Int

  userId String
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeFor User? @relation("UserActiveStatus")

  @@unique([userId, order])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String @default("")
  pronouns       String @default("")
  jobTitle       String @default("")
  department     String @default("")
  organization   String @default("")
  location       String @default("")
  workingWithYou String @default("")

  photoVisibility          ProfileVisibility @default(ANYONE)
  fullNameVisibility       ProfileVisibility @default(ANYONE)
  publicNameVisibility     ProfileVisibility @default(ANYONE)
  pronounsVisibility       ProfileVisibility @default(ANYONE)
  jobTitleVisibility       ProfileVisibility @default(ANYONE)
  departmentVisibility     ProfileVisibility @default(ANYONE)
  organizationVisibility   ProfileVisibility @default(ANYONE)
  locationVisibility       ProfileVisibility @default(ANYONE)
  localTimeVisibility      ProfileVisibility @default(ANYONE)
  workingWithYouVisibility ProfileVisibility @default(ANYONE)
  emailVisibility          ProfileVisibility @default(ADMINS_ONLY)
}

model ActivityEvent {
  id        String            @id @default(cuid())
  type      ActivityEventType
  payload   Json
  createdAt DateTime          @default(now())

  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
}

model RecentProject {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  openedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId, openedAt])
}

model RestoreUndoToken {
  id        String          @id
  expiresAt DateTime
  createdAt DateTime        @default(now())
  kind      RestoreUndoKind @default(CARDS)
  cards     Json

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}
