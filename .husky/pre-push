# Git feeds the refs being pushed on stdin. Capture them before any later
# command that might consume stdin (for example sourcing nvm).
push_refs=$(cat)

# Decide whether this push needs verify before looking for pnpm. A delete-only
# push must succeed even when pnpm is unavailable.
# Husky enables set -e. Disable it around the guard so exit 2 (skip verify)
# is not treated as a failed hook.
set +e
printf '%s\n' "$push_refs" | sh scripts/assert-pushing-clean-head.sh
status=$?
set -e

case "$status" in
  2) exit 0 ;;
  0) ;;
  *) exit 1 ;;
esac

# Git hooks run in a non-login, non-interactive shell, so the shell profile that
# activates nvm is never sourced and pnpm is missing from PATH. Load nvm here,
# then fall back to the common system install locations.
if ! command -v pnpm >/dev/null 2>&1; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    # nvm.sh is not written to run under `set -e`, which husky enables.
    set +e
    . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
    set -e
  fi
fi

if ! command -v pnpm >/dev/null 2>&1; then
  export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: pnpm was not found in PATH."
  echo "pre-push: install pnpm, or expose it to Git hooks via ~/.config/husky/init.sh."
  exit 1
fi

pnpm verify
